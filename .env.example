# Anthropic API (for cloud generation fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Local LLM Inference
LLAMA_MODEL_PATH=models/Meta-Llama-3-8B-Instruct.Q4_K_M.gguf
LLAMA_N_GPU_LAYERS=-1        # -1 = all layers on GPU, 0 = CPU
LLAMA_N_CTX=4096
LLAMA_N_BATCH=512
LLAMA_N_THREADS=8

# Dense Embedding Model
EMBED_MODEL_PATH=models/bge-large-en-v1.5
EMBED_DEVICE=cuda            # cuda | cpu

# Cross-Encoder Reranker & Qwen Extraction
RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
QWEN_MODEL_PATH=models/Qwen3.6-12B-IQ-Q4_K_M.gguf

# Storage & Database Paths
DATA_DIR=data
INGESTION_DIR=ingestion_mouth
HDD_BASE_PATH=data/ingestion_pool
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=legal_chunks
BM25_INDEX_PATH=data/bm25_index/bm25.pkl
GRAPH_PATH=data/knowledge_graph.json
INGESTION_LOG_PATH=data/ingestion_log.json

# API Endpoint
GRAPHRAG_API_URL=http://localhost:8000

# SharePoint Ingestion (Optional)
SP_ENABLED=false
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_TENANT_ID=
SP_SITE_URL=

# Logging
LOG_LEVEL=INFO
